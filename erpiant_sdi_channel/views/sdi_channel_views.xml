<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Form canale: nascondo channel_type (unica scelta possibile = Erpiant)
         e aggiungo i parametri del broker Erpiant. -->
    <record id="view_sdi_channel_form_erpiant" model="ir.ui.view">
        <field name="model">sdi.channel</field>
        <field name="inherit_id" ref="l10n_it_sdi_channel.view_sdi_channel_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_erpiant_pull_now"
                    type="object"
                    string="Sincronizza ora"
                    class="btn-primary"
                    attrs="{'invisible': [('channel_type', '!=', 'erpiant_aws')]}"
                />
            </xpath>
            <field name="channel_type" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="channel_type" position="after">
                <field name="erpiant_environment" />
                <field
                    name="erpiant_signature"
                    attrs="{'invisible': [('channel_type', '!=', 'erpiant_aws')]}"
                />
                <field
                    name="erpiant_endpoint_url"
                    attrs="{'invisible': [('channel_type', '!=', 'erpiant_aws')]}"
                    placeholder="https://sdi.erpiant.com/sdi"
                />
                <!-- Il token NON è più compilabile a mano (decisione utente
                     2026-08-09): arriva solo dall'attivazione con numero di licenza,
                     che lo ottiene dal sito. Un campo editabile qui permetteva di
                     incollare una credenziale arbitraria, scavalcando licenza,
                     wallet e tracciamento del commercialista. Resta visibile in sola
                     lettura al gruppo tecnico per diagnosi: sapere SE c'è un token
                     serve, poterlo scrivere no. -->
                <field
                    name="erpiant_activation_state"
                    attrs="{'invisible': [('channel_type', '!=', 'erpiant_aws')]}"
                />
                <field
                    name="erpiant_license_code"
                    placeholder="ERP-XXXX-XXXX-XXXX"
                    attrs="{'invisible': [('channel_type', '!=', 'erpiant_aws')]}"
                />
                <button
                    name="action_erpiant_activate"
                    type="object"
                    string="Attiva fatturazione elettronica"
                    class="btn-primary"
                    attrs="{'invisible': ['|', ('channel_type', '!=', 'erpiant_aws'), ('erpiant_activation_state', '=', 'active')]}"
                />
                <field
                    name="erpiant_tenant_ref"
                    attrs="{'invisible': ['|', ('channel_type', '!=', 'erpiant_aws'), ('erpiant_tenant_ref', '=', False)]}"
                />
                <field
                    name="erpiant_auth_token"
                    password="True"
                    readonly="1"
                    groups="erpiant_sdi_channel.group_sdi_developer"
                    attrs="{'invisible': [('channel_type', '!=', 'erpiant_aws')]}"
                />
            </field>
        </field>
    </record>

    <!-- Tree canale: nascondo la colonna channel_type. -->
    <record id="view_sdi_channel_tree_erpiant" model="ir.ui.view">
        <field name="model">sdi.channel</field>
        <field name="inherit_id" ref="l10n_it_sdi_channel.view_sdi_channel_tree" />
        <field name="arch" type="xml">
            <field name="channel_type" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <!-- Lock-down UI: il menu "ES Channels" è riservato al gruppo tecnico. -->
    <menuitem
        id="l10n_it_sdi_channel.menu_sdi_channel"
        groups="erpiant_sdi_channel.group_sdi_developer"
    />

</odoo>
