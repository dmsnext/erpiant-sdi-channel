<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Gruppo tecnico: unico abilitato a creare/modificare canali SDI.
         NON viene assegnato ad alcun utente del tenant: la gestione dei
         canali avviene solo via codice/post_init_hook (lock-down §7.7). -->
    <record id="group_sdi_developer" model="res.groups">
        <field name="name">Erpiant SDI: gestione canali (tecnico)</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>

    <!-- Lock-down ACL: revoca a account manager create/write/unlink su sdi.channel.
         Override del record definito da l10n_it_sdi_channel. -->
    <record id="l10n_it_sdi_channel.access_sdi_channel_manager" model="ir.model.access">
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <!-- Chi fattura può anche inviare allo SdI in un passaggio solo.

         `l10n_it_sdi_channel.res_groups_validate_send` governa il bottone
         "Validate, export and send to SdI" sulla fattura in bozza, ma a monte
         non è assegnato a nessuno: essendo un gruppo vuoto, in un tenant appena
         installato quel bottone NON lo vede neanche l'amministratore, e l'invio
         resta possibile solo per la via lunga (Export E-invoice -> aprire
         l'allegato -> Send to SdI). Per una microimpresa è attrito sulla
         operazione più frequente che farà.

         NON è un'estensione di privilegi: il bottone "Send to SdI" sull'allegato
         (l10n_it_sdi_channel/views/fatturapa_attachment_views.xml) non ha alcun
         attributo `groups`, quindi chi può già emettere fatture può già inviare.
         Qui cambia solo il numero di passaggi.

         Si implica da `account.group_account_invoice` (Fatturazione), che è il
         gradino più basso della gerarchia contabile: così lo ereditano anche
         Contabile e Amministratore di fatturazione. -->
    <record id="account.group_account_invoice" model="res.groups">
        <field
            name="implied_ids"
            eval="[(4, ref('l10n_it_sdi_channel.res_groups_validate_send'))]"
        />
    </record>

</odoo>
